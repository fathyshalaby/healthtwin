{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["app", "src", "apps/web/next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "packages", "apps/landing", "apps/native"]
}
